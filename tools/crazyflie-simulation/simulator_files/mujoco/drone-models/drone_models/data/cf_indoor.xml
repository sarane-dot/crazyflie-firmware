<mujoco model="cf_indoor">
  <compiler inertiafromgeom="false" meshdir="assets" autolimits="true" />

  <asset>
    <material name="black" rgba="0.102 0.102 0.102 1"/>
    <material name="gray" rgba="0.3 0.3 0.3 1"/>
    <material name="light-gray" rgba="0.7 0.7 0.7 1"/>
    <material name="silver" rgba="0.898 0.898 0.898 1"/>
    <material name="white" rgba="1 1 1 0.3"/>
    <material name="gold" rgba="0.969 0.878 0.6 1"/>
    <!-- The LED materials are initially transparent and can be changed dynamically -->
    <material name="led_top" rgba="1.0 1.0 1.0 0.0"/>
    <material name="led_bot" rgba="1.0 1.0 1.0 0.0"/>

    <mesh name="base_link" file="indoor_drone/base_link.STL" scale="1 1 1"/>
    <mesh name="prop_rr" file="indoor_drone/Link 1.STL" scale="1 1 1"/>
    <mesh name="prop_rl" file="indoor_drone/Link 2.STL" scale="1 1 1"/>
    <mesh name="prop_fl" file="indoor_drone/Link 3.STL" scale="1 1 1"/>
    <mesh name="prop_fr" file="indoor_drone/Link 4.STL" scale="1 1 1"/>
    <mesh name="led-diffusor" file="cf21B/cf_led-diffusor.stl" scale="1e-3 1e-3 1e-3"/>
  </asset>

  <default>
    <default class="cf2x">
      <default class="visual">
        <geom group="2" type="mesh" contype="0" conaffinity="0" />
      </default>
      <default class="collision">
        <geom group="3" condim="1" />
      </default>
      <site group="5" />
    </default>
  </default>

  <worldbody>
    <body name="drone" pos="0 0 0.05" childclass="cf2x">
      <site name="CoM" />
      <inertial pos="0.0 0.0 0.0" mass="0.13062" diaginertia="0.00025135 0.00045931 0.00022644" />

      <!-- Meshes -->
      <geom mesh="base_link" material="gray" class="visual" euler="90 0 0" />
      
      <!-- No led_bot/led_top for indoor drone, but crazysim expects them or doesn't care. -->
      <!-- We will just add them inside the body so it doesn't crash -->
      <geom name="led_top" mesh="led-diffusor" material="led_top" class="visual" pos="0 0 0.008" euler="180 0 0"/>
      <geom name="led_bot" mesh="led-diffusor" material="led_bot" class="visual" pos="0 0 -0.003"/>

      <!-- Collision geometry -->
      <geom  name="col_sphere" type="sphere" size="0.07" pos="0 0 0.005" class="collision" contype="1" conaffinity="1" />
      <geom  name="col_box" type="box" size="0.06 0.06 0.02" class="collision" rgba="0.5 0.5 0.5 0" contype="0" conaffinity="0" />

      <!-- Motors and Propellers (Hardware Numbering) -->
      <!-- motor0: M1 (Front Right) -->
      <site name="motor0" pos="0.059 -0.06 0.0" />
      <body name="prop0" pos="0.059 -0.06 -0.017895">
        <geom mesh="prop_fr" material="black" class="visual" euler="90 0 0"/>
      </body>
      <!-- motor1: M2 (Rear Right) -->
      <site name="motor1" pos="-0.060 -0.06 0.0" />
      <body name="prop1" pos="-0.060 -0.06 -0.017895">
        <geom mesh="prop_rr" material="black" class="visual" euler="90 0 0"/>
      </body>
      <!-- motor2: M3 (Rear Left) -->
      <site name="motor2" pos="-0.059 0.06 0.0" />
      <body name="prop2" pos="-0.059 0.06 -0.017895">
        <geom mesh="prop_rl" material="black" class="visual" euler="90 0 0"/>
      </body>
      <!-- motor3: M4 (Front Left) -->
      <site name="motor3" pos="0.06 0.06 0.0" />
      <body name="prop3" pos="0.06 0.06 -0.017895">
        <geom mesh="prop_fl" material="black" class="visual" euler="90 0 0"/>
      </body>
      
      <!-- Cameras -->
      <camera name="track_cam" pos="-1 0 .5" xyaxes="0 -1 0 1 0 2" mode="trackcom" />
      <camera name="fpv_cam" pos="0.03 0 0" euler="0 -90 -90" fovy="70" resolution="640 480" />
    </body>
  </worldbody>

  <actuator>
    <motor gear="0 0 1 0 0 0" site="motor0" name="motor0_force" />
    <motor gear="0 0 1 0 0 0" site="motor1" name="motor1_force" />
    <motor gear="0 0 1 0 0 0" site="motor2" name="motor2_force" />
    <motor gear="0 0 1 0 0 0" site="motor3" name="motor3_force" />
    <motor gear="0 0 0 0 0 1" site="motor0" name="motor0_torque" />
    <motor gear="0 0 0 0 0 1" site="motor1" name="motor1_torque" />
    <motor gear="0 0 0 0 0 1" site="motor2" name="motor2_torque" />
    <motor gear="0 0 0 0 0 1" site="motor3" name="motor3_torque" />
  </actuator>
</mujoco>
